{
	"name": "Grindstone.Editor.TextureImporter",
	"displayName": "Texture Importer",
	"version": "0.3.0",
	"description": "Allows the editor to import assets and convert them to a Grindstone-supported format.",
	"author": "Grindstone Foundation",
	"assetDirectories": [
		{
			"name": "Assets",
			"path": "assets",
			"mountPoint": "GRINDSTONE.EDITOR.TEXTUREIMPORTER",
			"loadStage": "EarlyEngineSetup",
			"dependencies": ["Grindstone.Editor.PipelineSetImporter:Importer"]
		}
	],
	"requiresPlugins": [{"name": "Grindstone.Editor.PipelineSetImporter"}],
	"binaries": [
		{
			"name": "Importer",
			"path": "lib/{Configuration}/PluginEditorTextureImporter",
			"loadStage": "EarlyEngineSetup",
			"buildType": "CMake",
			"buildTarget": "PluginEditorTextureImporter",
			"dependencies": ["Assets"]
		}
	],
	"cmake": "CMakeLists.txt"
}
