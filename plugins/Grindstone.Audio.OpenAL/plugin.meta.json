{
	"name": "Grindstone.Audio.OpenAL",
	"displayName": "OpenAL Audio System",
	"version": "0.3.0",
	"description": "Provides the OpenAL Audio System, AudioSource asset, and the AudioListenerComponent and AudioSourceComponent.",
	"author": "Grindstone Foundation",
	"assets": [],
	"requiresPlugins": [{"name": "Grindstone.Script.CSharp"}],
	"binaries": [
		{
			"name": "Audio",
			"path": "lib/{Configuration}/PluginAudioOpenAL",
			"loadStage": "EndOfEngineSetup",
			"buildType": "CMake",
			"buildTarget": "PluginAudioOpenAL"
		},
		{
			"name": "CSharpIntegration",
			"path": "scripts/bin/{Configuration}/net10.0/Grindstone.Audio.OpenAL.CSharpIntegration",
			"loadStage": "EndOfEngineSetup",
			"buildType": "Dotnet",
			"buildTarget": "scripts/CSharpIntegration.json",
			"dependencies": ["Audio", "Grindstone.Script.CSharp:CSharpCore"]
		}
	],
	"cmake": "CMakeLists.txt"
}
