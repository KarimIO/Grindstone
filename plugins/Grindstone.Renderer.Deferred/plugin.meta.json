{
	"name": "Grindstone.Renderer.Deferred",
	"displayName": "Deferred Renderer",
	"version": "0.3.0",
	"description": "The deferred renderer is a way of drawing the scene that focuses on drawing many lights simultaneously.",
	"author": "Grindstone Foundation",
	"requiresRestart": true,
	"requiresPlugins": [
		{ "name": "Grindstone.Editor.TextureImporter" },
		{ "name": "Grindstone.Editor.PipelineSetImporter" }
	],
	"assetDirectories": [
		{
			"name": "Assets",
			"path": "assets",
			"mountPoint": "GRINDSTONE.RENDERER.DEFERRED",
			"loadStage": "JustBeforeEndOfEngineSetup",
			"dependencies": ["Grindstone.Editor.TextureImporter:Importer", "Grindstone.Editor.PipelineSetImporter:Importer"]
		}
	],
	"binaries": [
		{
			"name": "DeferredRenderer",
			"path": "lib/{Configuration}/PluginRendererDeferred",
			"loadStage": "EndOfEngineSetup",
			"buildType": "CMake",
			"buildTarget": "PluginRendererDeferred",
			"dependencies": ["Assets"]
		}
	],
	"cmake": "CMakeLists.txt"
}
