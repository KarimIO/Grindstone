include "$GRINDSTONE.RENDERER.DEFERRED/pipelineSets/common/matrixTransformations.gpset"
include "$GRINDSTONE.RENDERER.DEFERRED/pipelineSets/common/postProcessingTemplate.gpset"

pipelineSet "Selection Outline" inherits "PostProcessing" {
	configuration "main" {
		pass "main" {
			shaderEntrypoint: vertex mainVertex
			shaderEntrypoint: fragment mainFragment
			renderQueue: "Gizmo"

			properties {
				cull: back
				depthBias: false
				depthWrite: false
				depthTest: false
				depthClamp: false
				depthCompareOp: lessOrEqual
				attachments: {
					colorMask: rgba
					blendPreset: additive
				}
			}

			requiresBlocks [
				GsInvertMatrix,
				GsViewNormal,
				GsComputeClipSpacePosition,
				GsComputeViewSpacePosition,
				GsLinearizeDepthFromNearFar
			]

			shaderHlsl {
				SamplerState screenSampler : register(s0, space1);
				Texture2D<uint> idRefImage : register(t1, space1);
				Texture2D<float> selectionDepthImage : register(t2, space1);
				Texture2D<float> sceneDepthImage : register(t3, space1);

				float4 mainFragment(VertexToFragment input) : SV_TARGET0 {
					// float d = selectionDepthImage.Sample(screenSampler, input.fragmentTexCoord);

					// Generate outline by comparing IDs between current pixel and surrounding
					// pixels. This will collect 4x4 IDs but we will only be using the upper
					// 3x3 taps.
					float4 id0 = idRefImage.Gather(screenSampler, input.fragmentTexCoord, int2(-2, -2));
					float4 id1 = idRefImage.Gather(screenSampler, input.fragmentTexCoord, int2( 0, -2));
					float4 id2 = idRefImage.Gather(screenSampler, input.fragmentTexCoord, int2(-2,  0));
					float4 id3 = idRefImage.Gather(screenSampler, input.fragmentTexCoord, int2( 0,  0));

					// Throw away unused taps and merge into two float4 and a center tap
					id2.xw = id1.xy;
					float id_center = id3.w;
					id3.w = id0.y;

					// Count ID misses and average together. a becomes our alpha of the outline.
					static const float avg_scalar = 1.f / 8.f;
					float a = dot(float4(id2 != id_center), avg_scalar);
					a += dot(float4(id3 != id_center), avg_scalar);

					[branch]
					if (a == 0) {
						return float4(0,0,0,0);
					}

					// To allow outline to bleed over objects and combat TAA jittering artifacts
					// sample depth of selection buffer in a 4x4 neighborhood and pick closest
					// depth.
					float4 dtap0 = selectionDepthImage.GatherRed(screenSampler, input.scaledFragmentTexCoord, int2(-2, -2));
					float4 dtap1 = selectionDepthImage.GatherRed(screenSampler, input.scaledFragmentTexCoord, int2( 0, -2));
					float4 dtap2 = selectionDepthImage.GatherRed(screenSampler, input.scaledFragmentTexCoord, int2(-2,  0));
					float4 dtap3 = selectionDepthImage.GatherRed(screenSampler, input.scaledFragmentTexCoord, int2( 0,  0));
					float d0 = min(dtap0.x, min(dtap0.y, min(dtap0.z, dtap0.w)));
					float d1 = min(dtap1.x, min(dtap1.y, min(dtap1.z, dtap1.w)));
					float d2 = min(dtap2.x, min(dtap2.y, min(dtap2.z, dtap2.w)));
					float d3 = min(dtap3.x, min(dtap3.y, min(dtap3.z, dtap3.w)));
					float d = min(d0, min(d1, min(d2, d3)));

					float2 near_far = float2(0.1f, 150.0f);
					float sceneDepth = sceneDepthImage.Sample(screenSampler, input.scaledFragmentTexCoord).r;
					float linearSceneDepth = LinearizeDepthFromNearFar(near_far.x, near_far.y, sceneDepth);
					float linearAverageSelectionDepth = LinearizeDepthFromNearFar(near_far.x, near_far.y, d);

					bool visible = linearAverageSelectionDepth <= linearSceneDepth;

					// If outline is hidden, reduce its alpha value to 30%.
					a *= visible ? 1.f : 0.6f;
					
					float3 outline_color = float3(1, 1, 0);

					return float4(outline_color * a, a);
				}
			}
		}
	}
}
