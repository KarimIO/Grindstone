include "$GRINDSTONE.RENDERER.DEFERRED/pipelineSets/deferredPipeline/lightingTemplate.gpset"

pipelineSet "Directional Light" inherits "DeferredLighting" {
	configuration "main" {
		pass "main" {
			shaderEntrypoint: vertex mainVertex
			shaderEntrypoint: fragment mainFragment

			requiresBlocks [
				GsRendererUniform,
				CommonConstants,
				poissonDisk,
				BSDF,
				LightGbufferUniforms,
				DiffuseDisney,
				GsComputeWorldSpacePosition
			]

			shaderHlsl {
				struct ShadowData {
					float4x4 shadowMatrix;
					float4 shadowRenderArea;
				};

				struct LightUbo {
					ShadowData shadowData[8];
					float4 shadowCascadeDistances[2]; // Each component is one distance, x2 for eight distances.
					float4x4 cameraViewMatrix;
					float3 color;
					uint cascadeCount;
					float3 direction;
					float dummy;
					float3 eyePosForShadowing; // This is different so that we can freeze/debug the view.
				};

				ConstantBuffer<LightUbo> light : register(b0, space2);

				float3 LightDirCalc(
					in float3 albedo,
					in float3 position,
					in float3 specularTexture,
					in float roughness,
					in float3 normal,
					in float3 lightDir,
					in float3 lightColor,
					in float3 eyePos
				) {
					float lightDistance	= length(lightDir);

					float3 eyeDir		= normalize(eyePos - position);
					float3 eyeReflect = reflect(-eyeDir, normal);

					lightDir		= -normalize(lightDir);

					float alpha = roughness * roughness;
					float alphaSqr = alpha * alpha;

					float NL = clamp(dot(normal, lightDir), 0, 1);

					float3 H = normalize(eyeDir + lightDir);

					float NV = abs(dot(normal, eyeDir)) + 0.00001;
					float NH = clamp(dot(normal, H), 0, 1);
					float LH = clamp(dot(lightDir, H), 0, 1);
					float VH = clamp(dot(eyeDir, H), 0, 1);

					float3 specular = BSDF(NV, NL, LH, NH, alpha, specularTexture.rgb);
					float diffDisney = DiffuseDisney(NV, NL, LH, roughness);
					float3 diffuse = albedo.rgb * float3(diffDisney, diffDisney, diffDisney) / PI;

					float3 BSDFValue = diffuse + specular;
					return float3(NL * BSDFValue * lightColor.xyz);
				}

				float GetCascadeDistance(uint i) {
					if (i < 4) {
						return light.shadowCascadeDistances[0][i];
					}
					
					return light.shadowCascadeDistances[1][i - 4];
				}

				uint GetLightCascadeByDepth(float3 position, float depthValue, uint cascadeCount) {
					for (uint i = 0; i < cascadeCount; ++i) {
						float4 cascadeQuad = light.shadowCascadeDistances[i / 4];
						float shadowCascadeDistance = GetCascadeDistance(i);
						if (depthValue <= shadowCascadeDistance) {
							return i;
						}
					}
					
					return cascadeCount;
				}

				uint GetLightCascadeByClosest(float3 position, uint cascadeCount) {
					for (uint i = 0; i < cascadeCount; ++i) {
						float4 clip = mul(light.shadowData[i].shadowMatrix, float4(position, 1));
						float3 proj = clip.xyz / clip.w;
						proj.xy = proj.xy * 0.5 + 0.5;

						bool inside =
							proj.x >= 0 && proj.x <= 1 &&
							proj.y >= 0 && proj.y <= 1 &&
							proj.z >= 0 && proj.z <= 1;

						if (inside) {
							return i;
						}
					}

					return cascadeCount;
				}

				float4 mainFragment(VertexToFragment input) : SV_TARGET0 {
					float4 gbufferSpecularRoughnessValue = gbufferSpecularRoughness.Sample(gbufferSampler, input.scaledFragmentTexCoord);

					float depth = gbufferDepth.Sample(gbufferSampler, input.scaledFragmentTexCoord).r;
					float3 position = ComputeWorldSpacePosition(rendererUbo.inverseProjectionMatrix, rendererUbo.inverseViewMatrix, input.fragmentTexCoord, depth);
					float3 albedo = gbufferAlbedo.Sample(gbufferSampler, input.scaledFragmentTexCoord).rgb;
					float3 normal = gbufferNormals.Sample(gbufferSampler, input.scaledFragmentTexCoord).rgb;
					float3 specular = gbufferSpecularRoughnessValue.rgb;
					float roughness = gbufferSpecularRoughnessValue.a;
					
					float3 lightDirection = light.direction;

					float3 litValues = LightDirCalc(
						albedo,
						position,
						specular,
						roughness,
						normal,
						lightDirection,
						light.color,
						light.eyePosForShadowing
					);

					static const float3 debugCascadeColors[9] = {
						float3(0,0,1),
						float3(0,1,0),
						float3(0,1,1),
						float3(1,0,0),
						float3(1,0,1),
						float3(1,1,0),
						float3(1,1,1),
						float3(0.5,0.5,1),
						float3(0,0,0)
					};
					
					uint layer = GetLightCascadeByClosest(position, light.cascadeCount);
					if (layer == light.cascadeCount) {
						return float4(litValues, 1);
					}

					float3 debugCascadeColor = debugCascadeColors[layer];
					ShadowData shadowData = light.shadowData[layer];

					float NdotL = saturate(dot(normal, -lightDirection));
					float bias = max(0.0005, 0.005 * (1.0 - NdotL));
					bias *= 1 / (GetCascadeDistance(layer) * 0.5f);
					float4 lightSpacePos = mul(shadowData.shadowMatrix, float4(position, 1));
					float3 projCoords = lightSpacePos.xyz / lightSpacePos.w;
					projCoords.xy = projCoords.xy * 0.5f + 0.5f;
					float pixelDepth = projCoords.z;

#define PCF
#ifdef PCF
					float2 resolution;
					float levels;
					shadowMap.GetDimensions(0, resolution.x, resolution.y, levels);
					float2 texelSize = 1.0f / (resolution * shadowData.shadowRenderArea.zw);
					static const float pcfKernelSize = 1.0f;
					float shadow = 0.0f;

					for (int i = 0; i < 16; ++i) {
						float randomAngle = ShadowRandom(float4(floor(input.scaledFragmentTexCoord.xy * 1000), 0, i));
						float2 rotation = float2(cos(randomAngle), sin(randomAngle));
						float2 offset = float2(
							rotation.x * poissonDisk[i].x - rotation.y * poissonDisk[i].y,
							rotation.y * poissonDisk[i].x + rotation.x * poissonDisk[i].y
						);

						float2 shadowUv = (projCoords.xy * shadowData.shadowRenderArea.zw) + shadowData.shadowRenderArea.xy;
						shadowUv = clamp(shadowUv, shadowData.shadowRenderArea.xy + texelSize * 2.0f, shadowData.shadowRenderArea.xy + shadowData.shadowRenderArea.zw - texelSize * 2.0f);
						float pcfDepth = shadowMap.Sample(gbufferSampler, shadowUv + offset * texelSize).r;
						bool isInLight = pcfDepth + bias >= pixelDepth;
						shadow += isInLight ? 1.0f : 0.0f;
					}

					shadow = shadow / 16;
#else
					float2 shadowUv = (projCoords.xy * shadowData.shadowRenderArea.zw) + shadowData.shadowRenderArea.xy;
					float pcfDepth = shadowMap.Sample(gbufferSampler, shadowUv).r;
					bool isInLight = pcfDepth + bias >= pixelDepth;
					float shadow = isInLight ? 1.0f : 0.0f;
#endif

					bool isInMap = all(projCoords >= 0) && all(projCoords <= 1);
					float isInLightMap = (isInMap) ? shadow : 0.0f;

					return float4(isInLightMap * litValues, 1);
				}
			}
		}
	}
}
