include "$GRINDSTONE.RENDERER.DEFERRED/pipelineSets/common/matrixTransformations.gpset"
include "$GRINDSTONE.RENDERER.DEFERRED/pipelineSets/common/rendererUniform.gpset"

computeSet "Screen-Space Reflections" {
	shaderEntrypoint: compute main

	requiresBlocks [
		GsViewNormal,
		GsComputeClipSpacePosition,
		GsComputeViewSpacePosition,
		GsViewSpaceToScreenSpace,
		GsRendererUniform,
		GsComputeWorldSpacePosition
	]

	shaderHlsl {
		SamplerState defaultSampler : register(s0, space1);
		RWTexture2D<half4> outImage : register(u1, space1);
		Texture2D<float4> colorImage : register(t2, space1);
		Texture2D<float4> gbufferDepth : register(t3, space1);
		Texture2D<float4> gbufferNormal : register(t4, space1);
		Texture2D<float4> gbufferSpecularRoughness : register(t5, space1);
		Texture2D<float4> ambientOcclusionImage : register(t6, space1);

		Texture2D<float4> brdfLUT : register(t0, space2);
		TextureCube<float4> environmentMap : register(t1, space2);

		float3 GetViewSpacePosition(float2 uv) {
			const float depth = gbufferDepth.Sample(defaultSampler, uv).r;
			const float3 positionViewSpace = ComputeViewSpacePosition(rendererUbo.inverseProjectionMatrix, uv, depth);
			return positionViewSpace;
		}

		static const float maxDistance = 15.0;
		static const int maxSteps = 96;

		void BinarySearchRefinement(float3 previousRayPos, float3 rayPos, out float2 hitUv, out float3 hitPos) {
			for (int j = 0; j < 6; ++j) {
				const float3 mid = (previousRayPos + rayPos) * 0.5;

				const float4 midScreen = ViewSpaceToScreenSpace(
					rendererUbo.projectionMatrix,
					float4(mid, 1.0),
					rendererUbo.renderResolution
				);

				const float2 midUv = midScreen.xy / rendererUbo.renderResolution;
				const float3 midScene = GetViewSpacePosition(midUv).xyz;

				if (midScene.z > mid.z) {
					previousRayPos = mid;
				}
				else {
					rayPos = mid;
				}

				hitUv = midUv;
				hitPos = mid;
			}
		}

		float3 ReflectRay(float4 positionFrom, float3 rayDir) {
			float3 rayPos = positionFrom.xyz;
			float3 previousRayPos = rayPos;

			float2 hitUv = 0;
			float3 hitPos = 0;
			float visibility = 0;

			for (int i = 0; i < maxSteps; ++i) {
				const float currentStep = lerp(0.05, 0.4, saturate(length(rayPos) / maxDistance));
		 
				previousRayPos = rayPos;
				rayPos += rayDir * currentStep;

				if (distance(rayPos, positionFrom.xyz) > maxDistance) {
					break;
				}

				const float4 screen = ViewSpaceToScreenSpace(
					rendererUbo.projectionMatrix,
					float4(rayPos, 1.0),
					rendererUbo.renderResolution
				);

				const float2 uv = screen.xy / rendererUbo.renderResolution;

				if (any(uv < 0.0) || any(uv > 1.0)) {
					break;
				}

				const float3 scenePos = GetViewSpacePosition(uv).xyz;
				const float thickness = max(0.02, abs(rayPos.z) * 0.02);

				if (abs(scenePos.z - rayPos.z) < thickness) {
					BinarySearchRefinement(previousRayPos, rayPos, hitUv, hitPos);
					visibility = 1.0;
					break;
				}
			}

			if (visibility == 0.0) {
				return float3(0,0,0);
			}
			
			//---------------------------------------
			// Reducing visibility due to edge/distance
			//---------------------------------------

			const float2 edge = abs(hitUv * 2.0 - 1.0);
			const float edgeFade = saturate(1.0 - max(edge.x, edge.y));
			const float distanceFade = saturate(1.0 - distance(hitPos, positionFrom.xyz) / maxDistance);
			visibility *= edgeFade * edgeFade;
			visibility *= distanceFade;

			return float3(hitUv, visibility);
		}

		float3 Light_F(in float3 f0, in float3 f90, in float VH) {
			return f0 + (f90 - f0) * pow(clamp(1 - VH, 0.0f, 1.0f), 5.0f);
		}

		float3 EvaluateEnvironmentMap(float2 texCoords, float depth, float3 eyeDir, float3 normalWorldSpace, float perceptualRoughness) {
			const float3 reflectRayWorld = reflect(-eyeDir, normalWorldSpace);
			static const float MAX_REFLECTION_LOD = 4.0;
			uint width, height, mipLevelCount;
			environmentMap.GetDimensions(0, width, height, mipLevelCount);
			const float3 prefilteredEnvMapColor = environmentMap.SampleLevel(defaultSampler, reflectRayWorld, perceptualRoughness * mipLevelCount).rgb;

			return prefilteredEnvMapColor;
		}

		float4 EvaluateSSR(float2 texCoords, float depth, float perceptualRoughness, uint mipCount) {
			const float4 positionViewSpace = float4(ComputeViewSpacePosition(rendererUbo.inverseProjectionMatrix, texCoords, depth), 1);
			const float3 normalViewSpace = normalize(ViewNormal(rendererUbo.viewMatrix, gbufferNormal.SampleLevel(defaultSampler, texCoords, 0).rgb));
			const float3 viewDir = normalize(-positionViewSpace.xyz);
			const float3 reflectedRayView = normalize(reflect(-viewDir, normalViewSpace));
			
			const float ssrMip = perceptualRoughness * (mipCount - 1);
			const float3 reflCoords = ReflectRay(positionViewSpace, reflectedRayView);
			const float3 ssrColor = colorImage.SampleLevel(defaultSampler, reflCoords.xy, ssrMip).rgb;

			return float4(ssrColor, reflCoords.b);
		}

		float3 CalculateSpecularBRDF(float3 specular, float roughness, float3 eyeDir, float3 normalWorldSpace) {
			const float NV = max(dot(normalWorldSpace, eyeDir), 0.0);
			const float3 f0 = 0.32 * specular * specular;
			const float oneMinusR = 1.0f - roughness;
			const float3 f90 = max(float3(oneMinusR, oneMinusR, oneMinusR), f0);
			const float3 F = Light_F(f0, f90, NV);
			const float2 envBRDF = brdfLUT.SampleLevel(defaultSampler, float2(NV, roughness), 0).rg;
			const float3 specularBRDF = (F * envBRDF.x + envBRDF.y);
			
			return specularBRDF;
		}

		[numthreads(4, 4, 1)]
		void main(uint3 dispatchThreadID : SV_DispatchThreadID) {
			float2 dimensions;
			uint mipCount;
			colorImage.GetDimensions(0, dimensions.x, dimensions.y, mipCount);
			const float2 texCoords = float2(dispatchThreadID.xy + 0.5) / dimensions.xy;
			if (texCoords.x >= 1 || texCoords.y >= 1) {
				return;
			}

			const float depth = gbufferDepth.Sample(defaultSampler, texCoords).r;
			const float3 positionWorldSpace = ComputeWorldSpacePosition(rendererUbo.inverseProjectionMatrix, rendererUbo.inverseViewMatrix, texCoords, depth);
			const float3 eyeDir = normalize(rendererUbo.eyePos.xyz - positionWorldSpace);
			const float3 normalWorldSpace = normalize(gbufferNormal.Sample(defaultSampler, texCoords).rgb);
			const float4 specRough = gbufferSpecularRoughness.SampleLevel(defaultSampler, texCoords, 0);
			const float3 specular = specRough.rgb;
			const float roughness = specRough.a * specRough.a;

			const float3 environmentMapReflection = EvaluateEnvironmentMap(texCoords, depth, eyeDir, normalWorldSpace, roughness);
			const float4 ssrReflection = EvaluateSSR(texCoords, depth, roughness, mipCount);
			const float3 specularBRDF = CalculateSpecularBRDF(specular, roughness, eyeDir, normalWorldSpace);
			const float ambientOcclusion = ambientOcclusionImage.Sample(defaultSampler, texCoords).r;

			const float ssrWeightMaxDecreaseDueToRoughness = 0.5f;
			const float ssrWeightDecreaseDueToRoughness = saturate(1.0 - roughness * ssrWeightMaxDecreaseDueToRoughness);
			const float ssrWeight = ssrReflection.a * ssrWeightDecreaseDueToRoughness;

			const float3 reflectionColor = lerp(environmentMapReflection, ssrReflection.rgb, ssrWeight) * specularBRDF * ambientOcclusion;

			const float3 regularColor = colorImage.SampleLevel(defaultSampler, texCoords, 0).rgb;
			outImage[dispatchThreadID.xy] = float4(regularColor + reflectionColor, 1);
		}
	}
}
