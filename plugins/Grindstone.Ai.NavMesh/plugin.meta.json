{
	"name": "Grindstone.Ai.NavMesh",
	"displayName": "Navigation Mesh System",
	"version": "0.1.0",
	"description": "Provides a set of tools to allow NavigationAgents to move through the world using Navigation Meshes.",
	"author": "Grindstone Foundation",
	"assets": [],
	"requiresPlugins": [{"name": "Grindstone.Script.CSharp"}],
	"binaries": [
		{
			"name": "NavMesh",
			"path": "lib/{Configuration}/PluginNavigationMesh",
			"loadStage": "EditorAfterUiSetup",
			"buildType": "CMake",
			"buildTarget": "PluginNavigationMesh"
		},
		{
			"name": "CSharpIntegration",
			"path": "scripts/bin/{Configuration}/net10.0/Grindstone.Ai.NavMesh.CSharpIntegration",
			"loadStage": "EditorAfterUiSetup",
			"buildType": "Dotnet",
			"buildTarget": "scripts/CSharpIntegration.json",
			"dependencies": ["NavMesh", "Grindstone.Script.CSharp:CSharpCore"]
		}
	],
	"cmake": "CMakeLists.txt"
}
